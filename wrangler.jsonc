{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "royilab-qrcode",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "ed1b90352506416fbbe56d23369ffcfb",
  "routes": [{ "pattern": "qrcode.royilab.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "royilab-qrcode",
      "database_id": "46f7536b-d7c1-4547-a056-8b092fab6998",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "royilab-qrcode-images" },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": { "APP_ORIGIN": "https://qrcode.royilab.com" },
}
