{
  "name": "royilab-qrcode",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "types": "wrangler types",
    "preview": "wrangler dev --port 8787",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:api": "node scripts/check-api.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.47.0",
    "qr-scanner": "1.4.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.2",
    "@vitejs/plugin-react": "6.1.1",
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vite": "8.3.0",
    "wrangler": "4.136.2",
    "qrcode": "1.5.4",
    "@types/qrcode": "1.5.6"
  }
}
